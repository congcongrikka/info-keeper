# ============================================================
#  信息管家 Info Keeper · 环境变量样例
#  复制为 .env.local（本地）或填进部署平台的环境变量面板
#
#  ⚠️ 本文件会进版本库：任何真实密钥、真实口令都不要写在这里。
#     不带 NEXT_PUBLIC_ 前缀的变量只在服务端读取，不会打包进浏览器 bundle。
#     标记为「仅服务端」的变量一律留空，由部署方自行注入。
# ============================================================

# ---------- Supabase ----------
# Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 可公开密钥（publishable / anon key）。靠 RLS 兜底，本身设计为可公开。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------- 大模型（OpenAI 兼容协议）----------
# 可选：不填 AI_API_KEY 则 AI 功能整体关闭，记录 / 检索 / 导出仍可用
AI_BASE_URL=https://api.your-provider.com/v1
AI_MODEL=your-model-name
# 仅服务端：绝不能加 NEXT_PUBLIC_ 前缀
AI_API_KEY=
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=45000
# AI_DISABLE_THINKING=true
# AI_DISABLED=true

# ---------- 邀请制注册 ----------
# 仅服务端：注册口令。留空 = 注册通道整体关闭（fail-closed，故意这么设计）
INVITE_CODE=
# INVITE_AUTO_CONFIRM=false
# 仅服务端：最高权限密钥，绝不能加 NEXT_PUBLIC_ 前缀。
# 配了它才能用 Admin API 建号并关掉 Supabase 的公开注册。
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 每日早报推送（Web Push）----------
# 自行生成一对，不要复用任何公开示例值：
#   npx web-push generate-vapid-keys
# 公钥会进浏览器 bundle（订阅时传给 pushManager），本身不保密
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# 仅服务端：泄露 = 别人能冒充你给所有订阅者发推送
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# 仅服务端：不配 = /api/cron/daily-reminder 返回 503（fail-closed）
CRON_SECRET=

# ---------- 邮件早报（SMTP）----------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@example.com
# 仅服务端：填邮箱的 SMTP 授权码，不是网页登录密码
SMTP_PASS=
# MAIL_FROM=your-account@example.com
# MAIL_FROM_NAME=信息管家
# 邮件里「查看全部」按钮指向的地址；不配则用部署平台的生产域名，
# 本地开发兜底 http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
